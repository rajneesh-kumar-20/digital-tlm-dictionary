{
  "name": "digital-tlm-dictionary",
  "version": "1.0.0",
  "scripts": {
    "server": "npm run dev --prefix Backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix Backend && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "start": "node Backend/server.js"
  }
}
